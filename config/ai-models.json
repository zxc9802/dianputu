{
  "textAnalysis": {
    "purpose": "Product document analysis, product info extraction, module brief generation, prompt planning",
    "apiKeyEnv": "TEXT_ANALYSIS_API_KEY",
    "baseUrl": "https://www.shanbaob.net/v1",
    "endpoint": "/chat/completions",
    "model": "gemini-3.1-pro-preview",
    "defaults": {
      "max_tokens": 4096,
      "temperature": 0.7
    }
  },
  "imageGeneration": {
    "purpose": "Default product detail image generation model used when the user has not selected another option",
    "defaultOptionId": "fallback",
    "apiKeyEnv": "FALLBACK_IMAGE_GENERATION_API_KEY",
    "baseUrl": "https://yunwu.ai/v1",
    "endpoint": "/images/generations",
    "model": "gpt-image-2-all",
    "defaults": {
      "size": "2048x2048",
      "n": 1
    },
    "options": [
      {
        "id": "primary",
        "label": "gpt image2(1)",
        "apiKeyEnv": "IMAGE_GENERATION_API_KEY",
        "baseUrl": "https://api.apiyi.com/v1",
        "endpoint": "/images/generations",
        "model": "gpt-image-2-vip",
        "defaults": {
          "size": "2048x2048",
          "output_format": "png",
          "response_format": "url"
        }
      },
      {
        "id": "fallback",
        "label": "gpt image2(2)",
        "apiKeyEnv": "FALLBACK_IMAGE_GENERATION_API_KEY",
        "baseUrl": "https://yunwu.ai/v1",
        "endpoint": "/images/generations",
        "model": "gpt-image-2-all",
        "defaults": {
          "size": "2048x2048",
          "n": 1
        },
        "retryGroups": 5,
        "backup": {
          "purpose": "Backup channel for gpt image2(2), used after Yunwu fails in each retry group",
          "apiKeyEnv": "FALLBACK_IMAGE_GENERATION_BACKUP_API_KEY",
          "baseUrl": "https://api-xai.ainaibahub.com/v1",
          "endpoint": "/images/generations",
          "model": "gpt-image-2",
          "defaults": {
            "size": "2048x2048",
            "n": 1
          }
        }
      },
      {
        "id": "gemini_flash_image",
        "label": "Gemini 3.1 Flash Image Preview",
        "apiKeyEnv": "GEMINI_FLASH_IMAGE_API_KEY",
        "baseUrl": "https://www.shanbaob.net/v1",
        "endpoint": "/chat/completions",
        "model": "gemini-3.1-flash-image-preview",
        "defaults": {
          "size": "2048x2048",
          "n": 1,
          "response_format": "b64_json"
        }
      }
    ],
    "fallback": {
      "purpose": "Fallback image generation endpoint used only when the primary endpoint fails for the current image",
      "apiKeyEnv": "FALLBACK_IMAGE_GENERATION_API_KEY",
      "baseUrl": "https://yunwu.ai/v1",
      "endpoint": "/images/generations",
      "label": "gpt image2(2)",
      "model": "gpt-image-2-all",
      "defaults": {
        "size": "2048x2048",
        "n": 1
      },
      "retryGroups": 5,
      "backup": {
        "purpose": "Backup channel for gpt image2(2), used after Yunwu fails in each retry group",
        "apiKeyEnv": "FALLBACK_IMAGE_GENERATION_BACKUP_API_KEY",
        "baseUrl": "https://api-xai.ainaibahub.com/v1",
        "endpoint": "/images/generations",
        "model": "gpt-image-2",
        "defaults": {
          "size": "2048x2048",
          "n": 1
        }
      }
    }
  }
}
