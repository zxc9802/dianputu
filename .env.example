# Text analysis / product information structuring
TEXT_ANALYSIS_API_KEY=replace_with_your_text_model_key
TEXT_ANALYSIS_BASE_URL=https://www.shanbaob.net/v1
TEXT_ANALYSIS_MODEL=gemini-3.1-pro-preview
TEXT_ANALYSIS_MAX_TOKENS=4096
TEXT_ANALYSIS_TEMPERATURE=0.7

# Optional image generation model selectable in the UI
DEFAULT_IMAGE_GENERATION_OPTION_ID=fallback
GEMINI_FLASH_IMAGE_API_KEY=replace_with_shanbaob_key
GEMINI_FLASH_IMAGE_BASE_URL=https://www.shanbaob.net/v1
GEMINI_FLASH_IMAGE_ENDPOINT_PATH=/chat/completions
GEMINI_FLASH_IMAGE_MODEL=gemini-3.1-flash-image-preview
GEMINI_FLASH_IMAGE_SIZE=2048x2048

# Primary image generation
IMAGE_GENERATION_API_KEY=replace_with_your_primary_image_model_key
IMAGE_GENERATION_LABEL=gpt image2(1)
IMAGE_GENERATION_BASE_URL=https://api.apiyi.com/v1
IMAGE_GENERATION_MODEL=gpt-image-2-vip
IMAGE_GENERATION_SIZE=2048x2048
IMAGE_GENERATION_N=0
IMAGE_GENERATION_OUTPUT_FORMAT=png
IMAGE_GENERATION_RESPONSE_FORMAT=url
IMAGE_GENERATION_RETRY_GROUPS=5

# gpt image2(1) backup channel. Used after primary fails, then the next retry group starts from primary again.
IMAGE_GENERATION_BACKUP_API_KEY=replace_with_your_gpt_image2_primary_backup_key
IMAGE_GENERATION_BACKUP_LABEL=gpt image2(1) backup
IMAGE_GENERATION_BACKUP_BASE_URL=https://api-xai.ainaibahub.com/v1
IMAGE_GENERATION_BACKUP_ENDPOINT_PATH=/images/generations
IMAGE_GENERATION_BACKUP_MODEL=gpt-image-2
IMAGE_GENERATION_BACKUP_SIZE=2048x2048
IMAGE_GENERATION_BACKUP_N=1

# Fallback image generation
FALLBACK_IMAGE_GENERATION_API_KEY=replace_with_your_fallback_image_model_key
FALLBACK_IMAGE_GENERATION_LABEL=gpt image2(2)
FALLBACK_IMAGE_GENERATION_BASE_URL=https://yunwu.ai/v1
FALLBACK_IMAGE_GENERATION_MODEL=gpt-image-2-all
FALLBACK_IMAGE_GENERATION_SIZE=2048x2048
FALLBACK_IMAGE_GENERATION_N=1
FALLBACK_IMAGE_GENERATION_RETRY_GROUPS=5

# gpt image2(2) backup channel. Used after Yunwu fails, then the next retry group starts from Yunwu again.
FALLBACK_IMAGE_GENERATION_BACKUP_API_KEY=replace_with_your_gpt_image2_backup_key
FALLBACK_IMAGE_GENERATION_BACKUP_LABEL=gpt image2(2) backup
FALLBACK_IMAGE_GENERATION_BACKUP_BASE_URL=https://api-xai.ainaibahub.com/v1
FALLBACK_IMAGE_GENERATION_BACKUP_ENDPOINT_PATH=/images/generations
FALLBACK_IMAGE_GENERATION_BACKUP_MODEL=gpt-image-2
FALLBACK_IMAGE_GENERATION_BACKUP_SIZE=2048x2048
FALLBACK_IMAGE_GENERATION_BACKUP_N=1

# PostgreSQL database (e.g. Zeabur managed PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Main-site SSO
MAIN_APP_URL=https://www.qycm.top
MAIN_APP_DETAIL_IMAGE_AGENT_ENTRY_PATH=/bot/detail-image-agent
MAIN_APP_DETAIL_IMAGE_AGENT_SSO_EXCHANGE_PATH=/api/detail-image-agent-sso/exchange
REQUIRE_MAIN_APP_SSO=true
DETAIL_IMAGE_AGENT_SESSION_SECRET=replace_with_a_long_random_secret
DETAIL_IMAGE_AGENT_SESSION_COOKIE_NAME=detail_image_agent_session
DETAIL_IMAGE_AGENT_SESSION_TTL_MINUTES=720
