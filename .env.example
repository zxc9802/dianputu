# Text analysis / product information structuring
TEXT_ANALYSIS_API_KEY=replace_with_your_text_model_key
TEXT_ANALYSIS_BASE_URL=https://www.shanbaob.net/v1
TEXT_ANALYSIS_MODEL=gemini-3.1-pro-preview
TEXT_ANALYSIS_MAX_TOKENS=4096
TEXT_ANALYSIS_TEMPERATURE=0.7

# Primary image generation
IMAGE_GENERATION_API_KEY=replace_with_your_primary_image_model_key
IMAGE_GENERATION_BASE_URL=https://api-xai.ainaibahub.com/v1
IMAGE_GENERATION_MODEL=gpt-image-2
IMAGE_GENERATION_SIZE=2048x2048
IMAGE_GENERATION_N=1
IMAGE_GENERATION_QUALITY=high
IMAGE_GENERATION_OUTPUT_FORMAT=png
IMAGE_GENERATION_RESPONSE_FORMAT=b64_json

# Fallback image generation
FALLBACK_IMAGE_GENERATION_API_KEY=replace_with_your_fallback_image_model_key
FALLBACK_IMAGE_GENERATION_BASE_URL=https://yunwu.ai/v1
FALLBACK_IMAGE_GENERATION_MODEL=gpt-image-2-all
FALLBACK_IMAGE_GENERATION_SIZE=2048x2048
FALLBACK_IMAGE_GENERATION_N=1

# PostgreSQL database (e.g. Zeabur managed PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname
